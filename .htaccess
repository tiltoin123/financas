RewriteEngine On

# Só permite acesso a /app/
RewriteCond %{REQUEST_URI} !/app/
RewriteRule ^ - [F]

# Sem listagem de pastas; pasta aberta serve o index.php dela
Options -Indexes
DirectoryIndex index.php

# Bloqueia acesso direto às views
<FilesMatch "\.html\.php$">
    Require all denied
</FilesMatch>