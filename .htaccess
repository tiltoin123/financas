
RewriteEngine On

# Permite somente o index.php da raiz e /app/
RewriteRule ^(index\.php|app(/.*)?)$ - [L]

# Bloqueia todos os demais caminhos
RewriteRule ^ - [F]

Options -Indexes
DirectoryIndex index.php

# Bloqueia acesso direto às views
<FilesMatch "\.html\.php$">
    Require all denied
</FilesMatch>

# Bloqueia arquivos ocultos
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
